        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:auto|paper|inverse)$/]",
        "message": "<Wordmark> tone must be one of 'auto' | 'paper' | 'inverse'."
      }
